# Copy to .env and adjust. All vars are optional; these are the defaults.

# --- LLM ---
NBA_SCOUT_LLM_PROVIDER=anthropic          # anthropic | bedrock
# NBA_SCOUT_ANTHROPIC_API_KEY=sk-ant-...
NBA_SCOUT_ANTHROPIC_MODEL=claude-sonnet-4-5
# NBA_SCOUT_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
NBA_SCOUT_AWS_REGION=us-east-1

# --- Embeddings ---
NBA_SCOUT_EMBEDDING_PROVIDER=fastembed     # fastembed | bedrock
NBA_SCOUT_EMBEDDING_DIM=384                # 384 for bge-small, 1024 for Titan v2
# NBA_SCOUT_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# --- Vector store ---
NBA_SCOUT_VECTOR_STORE=memory             # memory | pgvector
NBA_SCOUT_DATABASE_URL=postgresql://nba:nba@localhost:5432/nba_scout

# --- Retrieval ---
NBA_SCOUT_CHUNK_SIZE=900
NBA_SCOUT_CHUNK_OVERLAP=150
NBA_SCOUT_RETRIEVAL_TOP_K=5

# --- Stats tools ---
# If set, the stats agent calls a running nba-mcp-server; otherwise it uses nba_api directly.
# NBA_SCOUT_MCP_SERVER_URL=http://localhost:8000/mcp

# --- Observability ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
